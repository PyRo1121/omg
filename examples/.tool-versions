# ============================================================================
# NOTES
# ============================================================================

# Version Format:
# - Exact: "node 20.11.0" (recommended for reproducibility)
# - Prefix: "node 20" (uses latest 20.x)
# - Latest: "node latest" (not recommended for teams)
# - Channels: "rust stable", "rust nightly", "rust beta"

# Multiple Versions:
# You can specify multiple versions of the same runtime:
#   node 18.19.0
#   node 20.11.0
# OMG will use the LAST specified version as active.

# Environment Variables:
# Set runtime-specific environment variables in your shell config or .envrc:
#   export NODE_OPTIONS="--max-old-space-size=4096"
#   export RUST_BACKTRACE=1
#   export GOPATH=$HOME/go

# Team Workflow:
# 1. Project lead creates .tool-versions with locked versions
# 2. Commit .tool-versions to git
# 3. Team members run:
#      omg env sync  # Installs + activates all versions
# 4. CI/CD runs same command for reproducible builds

# Updating Versions:
#   omg use node latest  # Updates .tool-versions to latest Node
#   git diff .tool-versions  # Review changes
#   git commit -m "chore: bump node to latest"

# Checking Drift:
#   omg env check  # Shows mismatches between .tool-versions and current env
#   omg env diff   # Detailed diff output
