{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "schedule": [
    "after 10pm every weekday",
    "before 5am every weekday",
    "every weekend"
  ],
  "timezone": "America/Chicago",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "description": "Require review and dwell time for action digest changes"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepTypes": [
        "build-dependencies",
        "dev-dependencies"
      ],
      "matchManagers": [
        "cargo"
      ],
      "groupName": "Rust dev dependencies",
      "automerge": false,
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": [
        "/^serde/"
      ],
      "groupName": "serde ecosystem"
    },
    {
      "matchPackageNames": [
        "/^tokio/"
      ],
      "groupName": "tokio ecosystem"
    },
    {
      "matchPackageNames": [
        "/^clap/"
      ],
      "groupName": "clap CLI ecosystem"
    },
    {
      "description": "Review audited SLSA/Fulcio API upgrades separately from routine Cargo updates",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["sha2", "p256", "p384", "x509-parser"],
      "groupName": "audited verifier dependencies",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "matchPackageNames": [
        "clap"
      ],
      "enabled": false,
      "description": "Manually manage clap upgrades due to breaking changes"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "addLabels": [
      "priority"
    ],
    "assignees": []
  },
  "prConcurrentLimit": 5,
  "prCreation": "not-pending",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  }
}
