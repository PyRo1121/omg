FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    pkg-config \
    libapt-pkg-dev \
    libssl-dev \
    bc \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash omguser
USER omguser
WORKDIR /home/omguser/omg

# Install Rust from a pinned, hash-verified bootstrap.
RUN curl --proto '=https' --tlsv1.2 -fsSL \
        https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
        -o /home/omguser/rustup-init \
    && echo "20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c  /home/omguser/rustup-init" | sha256sum --check \
    && chmod +x /home/omguser/rustup-init \
    && /home/omguser/rustup-init -y --profile minimal --default-toolchain 1.95.0 \
    && rm -f /home/omguser/rustup-init
ENV PATH="/home/omguser/.cargo/bin:${PATH}"

# Set working directory
WORKDIR /home/omguser/omg

# Copy source (including .cargo/config.toml for linker fix)
COPY --chown=omguser:omguser . .

# Build with debian feature
RUN cargo build --release --no-default-features --features debian --locked

# Ensure scripts are executable
RUN chmod +x scripts/*.sh

# Set PATH and run without daemon (direct commands work without IPC)
ENV PATH="/home/omguser/omg/.cargo/bin:/home/omguser/omg/target/release:/home/omguser/.cargo/bin:${PATH}"
CMD ["/bin/bash", "-c", "omg search vim && echo 'Ubuntu search: SUCCESS' && /home/omguser/omg/target/release/omg --version"]
