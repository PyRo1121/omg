ARG BASE_IMAGE=debian:bookworm@sha256:6ebd97fa83deb272194a2cf015b3d26a4d538e9ad3a7a79d544c8af5b0a01443

FROM ${BASE_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libapt-pkg-dev \
    clang \
    cmake \
    zlib1g-dev \
    liblzma-dev \
    libbz2-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -fsSL \
        https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
        -o /usr/local/bin/rustup-init \
    && echo "20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c  /usr/local/bin/rustup-init" | sha256sum --check \
    && chmod +x /usr/local/bin/rustup-init \
    && /usr/local/bin/rustup-init -y --profile minimal --default-toolchain 1.95.0 \
    && rm -f /usr/local/bin/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"

COPY . .
RUN cargo build --release --no-default-features --features debian --locked

FROM ${BASE_IMAGE} AS final

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libapt-pkg-dev

COPY --from=builder /workspace/target/release/omg /usr/local/bin/omg
COPY --from=builder /workspace/target/release/omgd /usr/local/bin/omgd

CMD ["/bin/bash", "-lc", "omg --version && omg search bash"]
