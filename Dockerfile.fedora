# Fedora/RHEL E2E testing image (mirrors the ci.yml fedora matrix leg).
FROM fedora:latest@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup
ENV PATH="$CARGO_HOME/bin:$PATH"

RUN dnf install -y --setopt=install_weak_deps=False \
        git clang cmake openssl-devel pkgconfig findutils curl \
        rpm dnf sqlite yum-utils fedora-release && \
    curl --proto '=https' --tlsv1.2 -fsSL \
        https://static.rust-lang.org/rustup/archive/1.28.2/x86_64-unknown-linux-gnu/rustup-init \
        -o /usr/local/bin/rustup-init && \
    echo "20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c  /usr/local/bin/rustup-init" | sha256sum --check && \
    chmod +x /usr/local/bin/rustup-init && \
    /usr/local/bin/rustup-init -y --profile minimal --default-toolchain 1.95.0 && \
    rm -f /usr/local/bin/rustup-init && \
    $CARGO_HOME/bin/rustup component add clippy rustfmt

WORKDIR /workspace
COPY . .

# Build the exact release feature set used by release.yml for Fedora.
RUN cargo build --release --locked -j 2 --no-default-features --features fedora,pgp,license

# Smoke: read-only daily-driver paths against this distro's real package data.
CMD ["bash", "-c", "./target/release/omg --version && ./target/release/omg status --fast && ./target/release/omg search shell | head -5"]
