FROM debian:bookworm@sha256:6ebd97fa83deb272194a2cf015b3d26a4d538e9ad3a7a79d544c8af5b0a01443

# Install benchmarking tools and dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    time \
    hyperfine \
    && rm -rf /var/lib/apt/lists/*

# Create benchmark directory
WORKDIR /benchmark

# Copy the omg binary (will be provided at build time)
COPY target/release/omg /usr/local/bin/omg
RUN chmod +x /usr/local/bin/omg

# Copy Debian benchmark script
COPY benchmark_debian.sh /benchmark/benchmark_debian.sh
RUN chmod +x /benchmark/benchmark_debian.sh

# Ensure apt cache is populated
RUN apt-get update

CMD ["/benchmark/benchmark_debian.sh"]
