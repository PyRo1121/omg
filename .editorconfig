# EditorConfig - Consistent coding styles across editors
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust source files
[*.rs]
indent_size = 4
max_line_length = 100

# TOML configuration files
[*.toml]
indent_size = 2

# YAML files (CI, workflows)
[*.{yml,yaml}]
indent_size = 2

# Markdown documentation
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# JSON files
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefile (must use tabs)
[Makefile]
indent_style = tab
indent_size = 4

# Justfile (must use tabs)
[justfile]
indent_style = tab

# Package manager files
[{package.json,package-lock.json,Cargo.toml,Cargo.lock}]
indent_size = 2

# Git files
[.git*]
indent_size = 2
