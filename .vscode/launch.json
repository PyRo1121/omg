{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug omg",
      "cargo": {
        "args": [
          "build",
          "--bin=omg",
          "--features=arch"
        ],
        "filter": {
          "name": "omg",
          "kind": "bin"
        }
      },
      "args": ["search", "firefox"],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug omgd",
      "cargo": {
        "args": [
          "build",
          "--bin=omgd",
          "--features=arch"
        ],
        "filter": {
          "name": "omgd",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug unit tests",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "--lib",
          "--features=arch"
        ],
        "filter": {
          "name": "omg",
          "kind": "lib"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      }
    }
  ]
}
