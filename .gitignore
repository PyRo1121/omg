# ============================================
# OMG - Comprehensive .gitignore
# ============================================

# ---- Build outputs ----
/target
/fuzz/target/
dist/
site/dist/
omg-binary

# ---- Cargo ----
# Note: Cargo.lock IS committed (binary project, reproducible builds)
cargo.lock

# ---- Lock files (non-Cargo) ----
omg.lock
bun.lock
package-lock.json

# ---- Node / JS ----
node_modules/

# ---- Local secrets and environment overrides ----
.env
.env.*
!.env.example

# ---- Logs and debug output ----
*.log
cargo_tree_*.txt

# ---- Screenshots and generated images ----
screenshot-*.png

# ---- Dev scripts (organized versions live in scripts/) ----
benchmark_ubuntu.sh
build-pgo.sh
deploy.sh
diag.sh
release.sh
release_and_publish.sh
test_*.sh

# ---- Benchmark reports (keep latest.md + summary.json only) ----
benchmark_report.md
benchmark_results/
benchmarks/report_*.md

# ---- Editor / IDE / Tool state ----
.windsurf/
.sisyphus/
.ui-design/
.omg/
.vscode/
.idea/
*.swp
*.swo
*~
.wrangler/
.worktrees/

# ---- OS files ----
.DS_Store
Thumbs.db

